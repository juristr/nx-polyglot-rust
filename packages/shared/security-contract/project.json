{
  "name": "security-contract",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/shared/security-contract/src",
  "projectType": "library",
  "tags": [
    "scope:shared",
    "type:data",
    "type:contract",
    "lang:rust",
    "lang:typescript"
  ],
  "targets": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "outputs": ["{projectRoot}/dist"],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/shared/security-contract",
        "command": "tsc --build tsconfig.lib.json --force"
      }
    },
    "generate": {
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/rust/**/*",
        "{workspaceRoot}/packages/topcoat/security-domain/src/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/.mise.toml",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "outputs": [
        "{projectRoot}/schema/security-snapshot.schema.json",
        "{projectRoot}/src/generated.ts"
      ],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "mise exec -- cargo run -p security-contract --bin generate-contract",
          "pnpm --filter @polyglot/security-contract exec json2ts -i schema/security-snapshot.schema.json -o src/generated.ts --no-additionalProperties",
          "pnpm exec prettier --write packages/shared/security-contract/schema/security-snapshot.schema.json packages/shared/security-contract/src/generated.ts"
        ],
        "parallel": false
      }
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/.mise.toml",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm --filter @polyglot/security-contract exec vitest run",
          "mise exec -- cargo test -p security-contract"
        ],
        "parallel": false
      }
    }
  }
}

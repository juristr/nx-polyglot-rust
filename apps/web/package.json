{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 4200",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview"
  },
  "nx": {
    "name": "web",
    "tags": [
      "scope:web",
      "type:app"
    ],
    "targets": {
      "dev": {
        "continuous": true,
        "dependsOn": [
          {
            "projects": [
              "topcoat-security"
            ],
            "target": "run"
          }
        ]
      },
      "build": {
        "cache": true,
        "inputs": [
          "production",
          "^production",
          {
            "externalDependencies": [
              "vite"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "typecheck": {
        "cache": true,
        "dependsOn": [
          "^typecheck"
        ],
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/web",
          "command": "tsc -p tsconfig.typecheck.json"
        }
      }
    }
  },
  "dependencies": {
    "@polyglot/dashboard-ui": "workspace:*",
    "@polyglot/topcoat-client": "workspace:*",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}

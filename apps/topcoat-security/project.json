{
  "name": "topcoat-security",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/topcoat-security/src",
  "tags": ["scope:topcoat", "type:app", "lang:rust"],
  "targets": {
    "build": {
      "cache": true,
      "dependsOn": [{ "projects": ["security-globe"], "target": "vite:build" }],
      "executor": "@monodon/rust:build",
      "outputs": ["{options.target-dir}"],
      "options": {
        "target-dir": "dist/target/topcoat-security/build"
      },
      "configurations": {
        "production": {
          "release": true
        }
      }
    },
    "test": {
      "cache": true,
      "executor": "@monodon/rust:test",
      "outputs": ["{options.target-dir}"],
      "options": {
        "target-dir": "dist/target/topcoat-security/test"
      },
      "configurations": {
        "production": {
          "release": true
        }
      }
    },
    "lint": {
      "cache": true,
      "executor": "@monodon/rust:lint",
      "outputs": ["{options.target-dir}"],
      "options": {
        "target-dir": "dist/target/topcoat-security/lint"
      }
    },
    "run": {
      "executor": "@monodon/rust:run",
      "dependsOn": [{ "projects": ["security-globe"], "target": "vite:build" }],
      "outputs": ["{options.target-dir}"],
      "options": {
        "target-dir": "dist/target/topcoat-security/run"
      },
      "configurations": {
        "production": {
          "release": true
        }
      }
    }
  }
}
